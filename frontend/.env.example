# Banco já configurado na Vercel
DATABASE_URL=postgresql://...

# URL pública de produção do Cave (sem barra no final)
NEXT_PUBLIC_APP_URL=https://cave-zeta.vercel.app

# Gere uma vez: npx web-push generate-vapid-keys --json
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:seu-email@exemplo.com

# Crie em https://console.upstash.com/qstash
QSTASH_TOKEN=

# Frase aleatória longa usada apenas entre QStash e /api/push/send
PUSH_JOB_SECRET=
